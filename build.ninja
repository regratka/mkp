ninja_required_version = 1.5
builddir = build\me2\src
cl = tools\msvc66\Bin\CL.exe
cl_flags = /Zi /O2 /GR /G6 /GX /I include/ /I include\me2 /I tools/msvc66/include /I tools/dx8/include
rule cc
  command = $cl /nologo $cl_flags /c $in /Fd$out.pdb /Fo$out
  deps = msvc
build $builddir/cVideoPlayer.obj: cc src\me2\cVideoPlayer.cpp | include\me2\cVideoPlayer.h
build $builddir/CCPUTicker.obj: cc src\me2\CCPUTicker.cpp | include\me2\CCPUTicker.h
build $builddir/cMagLog.obj: cc src\me2\cMagLog.cpp | include\me2\cMagLog.h
build $builddir/cMagKernel.obj: cc src\me2\cMagKernel.cpp | include\me2\cMagKernel.h
build $builddir/cMp3Player.obj: cc src\me2\cMp3Player.cpp | include\me2\cMp3Player.h
build $builddir/StateObject_Str.obj: cc src\me2\StateObject_Str.cpp | include\me2\StateObject_Str.h
